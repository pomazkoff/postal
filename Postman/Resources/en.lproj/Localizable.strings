"tap.ch3.cable" = "A cable in the cut. No more stakes after this.";
"tap.ch3.nails.title" = "Nails";
"tap.ch3.nails" = "A jar of nails. A dull knock.";
"tap.ch3.boat.title" = "The boat";
"tap.ch3.boat" = "The boat is on trestles, far from the water. The old man says it is too damp for a boat here.";
"tap.ch3.smoke.title" = "Smoke";
"tap.ch3.smoke" = "A thread of smoke from the hut's pipe.";
"tap.ch3.stack.title" = "A stack";
"tap.ch3.stack" = "A stack of poles by the planks.";
"tap.ch3.frog1.title" = "A frog";
"tap.ch3.frog1" = "A short croak. It sits again.";
"tap.ch3.bubble1.title" = "A bubble";
"tap.ch3.bubble1" = "A bubble rises and pops.";
"tap.ch3.hummock.title" = "A hummock";
"tap.ch3.hummock" = "The hummock sinks a little and rises.";
"tap.ch3.boots.title" = "Prints";
"tap.ch3.boots" = "The boot prints are full of water.";
"tap.ch3.stake.title" = "A stake";
"tap.ch3.stake" = "A faded ribbon on the stake. The card reads Somov F.I.";
"tap.ch3.ripples.title" = "Rings";
"tap.ch3.ripples" = "Rings on the water. No step to be seen.";
"tap.ch3.duckweed.title" = "Duckweed";
"tap.ch3.duckweed" = "The duckweed parts and closes.";
"tap.ch3.pole.title" = "A pole";
"tap.ch3.pole" = "A pole in the silt. Not a single nick.";
"tap.ch3.hut.title" = "The hut";
"tap.ch3.hut" = "The door is on a hook. Inside it is dry and empty.";
"tap.ch3.frog2.title" = "A frog";
"tap.ch3.frog2" = "A short croak. It sits again.";
"tap.ch3.bubble2.title" = "A bubble";
"tap.ch3.bubble2" = "A bubble rises and pops.";
"tap.ch3.tally.title" = "The tally";
"tap.ch3.tally" = "A card is stuck halfway through the stamp. A dry click.";
"tap.ch3.peat.title" = "Peat";
"tap.ch3.peat" = "A stack of peat. Like a back, and not alive.";
"tap.ch3.dryer.title" = "The dryer";
"tap.ch3.dryer" = "A boot dryer. Empty.";
"tap.ch3.duty.title" = "On duty";
"tap.ch3.duty" = "A yellow “on duty” in an empty window.";
"tap.ch3.louder.title" = "A note";
"tap.ch3.louder" = "The post says: louder toward the top.";
"tap.ch3.barge.title" = "The barge";
"tap.ch3.barge" = "A barge by the bank. The name on the side cannot be finished.";
"tap.ch3.bell.title" = "The bell";
"tap.ch3.bell" = "A rusty bell. One dull stroke.";
"tap.ch3.spawn.title" = "Spawn";
"tap.ch3.spawn" = "Spawn like clay beads.";
"tap.ch3.heron.title" = "The heron";
"tap.ch3.heron" = "The heron stands and sits back on the same hummock.";
"tap.ch3.frog3.title" = "A frog";
"tap.ch3.frog3" = "A short croak. It sits again.";
"tap.ch3.reeds.title" = "Reeds";
"tap.ch3.reeds" = "The reeds rustle.";
"tap.ch3.verst.title" = "The post";
"tap.ch3.verst" = "A verst post. The figure is washed off.";
"tap.ch3.bubble3.title" = "Bubbles";
"tap.ch3.bubble3" = "Bubbles on the live channel. They pop.";
"tap.ch3.radio.title" = "The radio";
"tap.ch3.radio" = "A scrap of a song. Then only noise.";
"tap.ch3.wall.title" = "The wall";
"tap.ch3.wall" = "A grey wall across the river. Nobody says what it is.";
"tap.ch3.door.title" = "A door";
"tap.ch3.door" = "A box door in the wall.";
"tap.ch3.rim.title" = "A rim";
"tap.ch3.rim" = "A rim. Round, and that is all.";
"tap.ch3.thermos.title" = "A thermos";
"tap.ch3.thermos" = "A thermos. The lid will not unscrew.";
"tap.ch3.passwall.title" = "A pass";
"tap.ch3.passwall" = "A pass on a string. An old pattern.";
"tap.ch3.pole2.title" = "A pole";
"tap.ch3.pole2" = "Someone else's pole by the water. The nick is high.";
"tap.ch3.lids.title" = "Lids";
"tap.ch3.lids" = "The settling lids are flat.";
"tap.ch3.kettle.title" = "The kettle";
"tap.ch3.kettle" = "The kettle is warm. It is empty inside.";
"tap.ch3.cordon.title" = "The cordon";
"tap.ch3.cordon" = "Boards. They say: cordon.";
"tap.ch3.barrier.title" = "The barrier";
"tap.ch3.barrier" = "The barrier does not open.";
"tap.ch3.pipes.title" = "Pipes";
"tap.ch3.pipes" = "Pipes in a break in the fog. Then the sheet again.";
